# Copy this file to .env.local and fill in real values — copy, don't rename, so
# this template stays in the repo. .env.local is gitignored; this file is not,
# so never put real credentials here.
#
# Storage is any S3-compatible object store. The project currently runs on
# Cloudflare R2 (docs/R2-SETUP.md); moving to AWS S3 (docs/S3-SETUP.md) is a
# change to this file only — no code changes. Both layouts are shown below.

# ---------------------------------------------------------------------------
# Cloudflare R2 (current) — see docs/R2-SETUP.md
# ---------------------------------------------------------------------------

# Bucket that stores the photos and manifest.json.
S3_BUCKET=sams-polaroids

# R2 ignores the region but the AWS SDK insists on one. "auto" is what
# Cloudflare tells you to use.
S3_REGION=auto

# R2's S3-compatible API endpoint. Your account ID is in the Cloudflare
# dashboard under R2 → Overview. Setting this is what points the upload script
# at R2 instead of AWS — deleting it sends the script back to real S3.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 API token credentials (R2 → Manage API Tokens). Unlike AWS, R2 has no
# credential chain to fall back on, so these must be set explicitly here.
# The secret is shown exactly once when you create the token.
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Public base URL photos are served from — no trailing slash. This is what the
# Next.js app reads to fetch manifest.json, and what upload.mjs uses to build
# each photo's `full`/`thumb` URLs.
#
# r2.dev dev URL:  https://pub-xxxxxxxx.r2.dev   (rate-limited, dev only)
# Custom domain:   https://photos.yourdomain.com (cached at the edge, preferred)
PHOTOS_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ---------------------------------------------------------------------------
# Web upload (/upload) — see docs/WEB-UPLOAD.md
# ---------------------------------------------------------------------------
# Both are REQUIRED for /upload to work. Without them the page refuses to
# authenticate anyone, which is the correct failure mode — an upload endpoint
# that writes to your real bucket must never be reachable unauthenticated.

# The password you type at /upload. Pick something long; it's the only thing
# standing between the internet and your bucket.
UPLOAD_PASSWORD=change-me-to-something-long

# Signs the session cookie. Any long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this immediately invalidates every existing session.
AUTH_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# AWS S3 (swap target) — see docs/S3-SETUP.md
# ---------------------------------------------------------------------------
# To move to S3: comment out the R2 block above and uncomment this one. The
# only real work is deleting S3_ENDPOINT — with it gone the AWS SDK talks to
# real S3, and credentials come from the default chain instead of this file.
#
# S3_BUCKET=sam-polaroids-photos
# S3_REGION=us-east-1
# PHOTOS_BASE_URL=https://sam-polaroids-photos.s3.us-east-1.amazonaws.com
#
# Credentials come from the default AWS credential chain, NOT from this file.
# Configure the profile once with: aws configure --profile polaroids
# AWS_PROFILE=polaroids
